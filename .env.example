# ==========================================
# SENTINEL V2 BACK-END CONFIGURATION
# ==========================================

# --- APP CONFIG ---
NODE_ENV=development
PORT=8080

# --- DATABASE CONFIG ---
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/sentinelV2?schema=public"

# --- AUTH CONFIG ---
# Secret key for signing JWT tokens
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_KEY"

# --- MACHINE LEARNING API CONFIG ---
# Microservice FastAPI base URL
ML_API_BASE_URL="http://localhost:8000"

# --- OPENWEATHER CONFIG ---
# API key and airport GPS coordinates for weather tracking
OPENWEATHER_API_KEY="YOUR_OPENWEATHERMAP_API_KEY"
OPENWEATHER_LATITUDE=-1.63806
OPENWEATHER_LONGITUDE=103.6444
